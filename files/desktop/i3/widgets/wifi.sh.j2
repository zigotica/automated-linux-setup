widget_wifi() {
  local link wifi ssid signal color=$red
  local interface={{ wifi_interface | default('') | quote }}

  link=$(iw dev "$interface" link 2>/dev/null)
  ssid=$(awk '/^[[:space:]]*SSID:/ {
      sub(/^[[:space:]]*SSID:[[:space:]]*/, "")
      print
      exit
    }' <<< "$link")
  wifi=$(awk '/signal:/ {print $2 "dBm"; exit}' <<< "$link")

  if [[ $wifi =~ ^-?[0-9]+dBm$ ]]; then
    signal=${wifi%dBm}
    if (( signal >= -60 )); then
      color=$green
    elif (( signal >= -70 )); then
      color=$yellow
    fi

    # Keep the i3bar JSON valid if the SSID contains quotes or backslashes.
    ssid=${ssid//\\/\\\\}
    ssid=${ssid//\"/\\\"}
    wifi="$ssid $wifi"
  else
    wifi='DOWN'
  fi

  printf '{"full_text":"WiFi %s","color":"%s","separator":false}' "$wifi" "$color"
}
